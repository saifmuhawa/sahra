{"id":296096,"imdb":"tt2674426","en":"Me Before You","orig":"Me Before You","ar":"أنا قبلك","tag":"عش بجرأة","ov":"فتاة بلدة صغيرة عالقة بين وظائف مسدودة. يصبح رجل ناجح رفيع المستوى مقيدًا على كرسي متحرك بعد وقوع حادث. يقرر الرجل أن حياته لا تستحق العيش حتى يتم تعيين الفتاة لمدة ستة أشهر لتكون القائم بأعماله الجديدة. عالمان منفصلان ومحاصران بسبب الظروف ، بدأ الاثنان بداية صعبة. لكن الفتاة مصممة على أن تثبت للرجل أن الحياة تستحق العيش ، وبينما يشرعان في سلسلة من المغامرات معًا ، يجد كل منهما عالمه يتغير بطرق لا يمكن لأي منهما أن يتخيلها.","rd":"2016-06-01","rt":110,"g":[18,10749],"lang":"en","budget":20000000,"revenue":207945075,"companies":[{"n":"New Line Cinema","logo":"/2ycs64eqV5rqKYHyQK0GVoKGvfX.png","c":"US"},{"n":"Sunswept Entertainment","logo":null,"c":"US"},{"n":"Metro-Goldwyn-Mayer","logo":"/usUnaYV6hQnlVAXP6r4HwrlLFPG.png","c":"US"}],"countries":["US"],"langs":["English"],"col":null,"rel":[{"c":"KR","d":"2016-06-01"},{"c":"AE","d":"2016-06-02"},{"c":"DK","d":"2016-06-02"},{"c":"IL","d":"2016-06-02"},{"c":"SG","d":"2016-06-02"},{"c":"TH","d":"2016-06-02"},{"c":"CA","d":"2016-06-03"},{"c":"EE","d":"2016-06-03"},{"c":"GB","d":"2016-06-03"},{"c":"IE","d":"2016-06-03"},{"c":"IN","d":"2016-06-03"},{"c":"KH","d":"2016-06-03"},{"c":"LT","d":"2016-06-03"},{"c":"LV","d":"2016-06-03"},{"c":"NO","d":"2016-06-03"},{"c":"US","d":"2016-06-03"},{"c":"VN","d":"2016-06-03"},{"c":"PL","d":"2016-06-10"},{"c":"BE","d":"2016-06-15"},{"c":"PH","d":"2016-06-15"},{"c":"AU","d":"2016-06-16"},{"c":"BR","d":"2016-06-16"},{"c":"CL","d":"2016-06-16"},{"c":"HU","d":"2016-06-16"},{"c":"NL","d":"2016-06-16"},{"c":"SE","d":"2016-06-17"},{"c":"TR","d":"2016-06-17"},{"c":"TW","d":"2016-06-17"},{"c":"CH","d":"2016-06-22"},{"c":"FR","d":"2016-06-22"},{"c":"AL","d":"2016-06-23"},{"c":"AR","d":"2016-06-23"},{"c":"AT","d":"2016-06-23"},{"c":"BA","d":"2016-06-23"},{"c":"DE","d":"2016-06-23"},{"c":"HR","d":"2016-06-23"},{"c":"SA","d":"2016-06-23"},{"c":"SI","d":"2016-06-23"},{"c":"UY","d":"2016-06-