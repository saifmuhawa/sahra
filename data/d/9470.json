{"id":9470,"imdb":"tt0373074","en":"Kung Fu Hustle","orig":"功夫","ar":"Kung Fu Hustle","tag":"So many gangsters… so little time.","ov":"تدور أحداث الفيلم في مدينة شنغهاي الصينية خلال أربعينيات القرن العشرين؛ حيث كانت عصابة تسمى عصابة الفأس هي المسيطر الحقيقي على المدينة.\r يحاول الفتى (سينج)؛ الذي يعيش في أحد الأحياء الفقيرة بالمدينة، أن ينضم للعصابة، ومن أجل ذلك يقوم بتنفيذ عدة مهام لصالح زعماء أحد الأحياء، والذين يكتشف لاحقًا أنهم من أعظم معلمي رياضة الكونغ فو.\r تؤدي مهام سينج إلى حدوث المواجهة بين العصابة ومعلمي الكونغ فو، ويجد سينج نفسه وسط معركة كبرى يجب على من يرغب بالنصر فيها أن يثبت مهاراته في الكونغ فو.","rd":"2004-02-10","rt":99,"g":[28,35,80,14],"lang":"cn","budget":20000000,"revenue":102034104,"companies":[{"n":"Huayi Brothers & Taihe Film Investment","logo":null,"c":"CN"},{"n":"Star Overseas","logo":null,"c":"HK"},{"n":"Beijing Film Studio","logo":null,"c":"CN"},{"n":"CP Film Production Asia","logo":null,"c":"HK"},{"n":"China Film Group Corporation","logo":"/7osqu50JpFIh0klZU0s1CrnNqcc.png","c":"CN"}],"countries":["CN","HK"],"langs":["Cantonese"],"col":null,"rel":[{"c":"TH","d":"2004-02-10"},{"c":"CA","d":"2004-09-14"},{"c":"CN","d":"2004-12-13"},{"c":"SG","d":"2004-12-20"},{"c":"HK","d":"2004-12-22"},{"c":"TW","d":"2004-12-24"},{"c":"JP","d":"2005-01-01"},{"c":"KR","d":"2005-01-13"},{"c":"FR","d":"2005-03-11"},{"c":"US","d":"2005-04-08"},{"c":"IT","d":"2005-05-27"},{"c":"CH","d":"2005-06-02"},{"c":"DE","d":"2005-06-02"},{"c":"AT","d":"2005-06-03"},{"c":"ES","d":"2005-06-03"},{"c":"SE","d":"2005-06-03"},{"c":"GB","d":"2005-06-07"},{"c":"CZ","d":"2005-06-16"},{"c":"HU","d":"2005-06-23"},{"c":"RU","d":"2005-06-23"},{"c":"IE","d":"2005-06-24"},{"c":"NL","d":"2005-07-14"},{"c":"BR","d":"2005-07-15"},{"c":"AU","d":"2005-08-11"},{"c":"MX","d":"2005-08-25"}],"dir":["Stephen Chow"],"prod":["Stephen Chow","Jeffrey Lau Chun-wai","Chui Po Chu","Yang Bu Ting","Wang Zhong Jun","Han San Ping"],"wri":["Stephen Chow","Tsang Kan-cheong","Xin Huo","Chan Man Keung"],"mus"