{"id":550,"imdb":"tt0137523","en":"Fight Club","orig":"Fight Club","ar":"نادي القتال","tag":"نادي القتال هو نادي يوجد في العقل الباطن لكل واحد منا !","ov":"يعيش موظف مكتبي يعاني من الأرق والملل حياة روتينية فارغة، إلى أن يلتقي بالرجل الغامض تايلر ديردن، الذي يختلف عنه تمامًا ويؤمن بأن التحرر من قيود المجتمع يبدأ برفض الحياة التقليدية. تنشأ بينهما صداقة غريبة تقودهما إلى تأسيس نادٍ سري يتجمع فيه الرجال لخوض معارك جسدية بعيدًا عن أعين الناس، لكن النادي سرعان ما يتحول إلى حركة أكثر خطورة تسعى إلى تحدي النظام القائم. ومع تصاعد الأحداث، يبدأ الرجل في اكتشاف حقائق صادمة عن تايلر وعن نفسه، فتتغير نظرته إلى حياته وكل ما كان يعتقد أنه يعرفه.","rd":"1999-10-15","rt":139,"g":[18,53],"lang":"en","budget":63000000,"revenue":100853753,"companies":[{"n":"Fox 2000 Pictures","logo":"/tEiIH5QesdheJmDAqQwvtN60727.png","c":"US"},{"n":"Regency Enterprises","logo":"/4sGWXoboEkWPphI6es6rTmqkCBh.png","c":"US"},{"n":"Linson Entertainment","logo":"/A32wmjrs9Psf4zw0uaixF0GXfxq.png","c":"US"},{"n":"20th Century Fox","logo":"/nM2MfoMqzJQRiSynsDabOtFKetD.png","c":"US"},{"n":"Taurus Film","logo":"/hD8yEGUBlHOcfHYbujp71vD8gZp.png","c":"DE"}],"countries":["DE","US"],"langs":["English"],"col":null,"rel":[{"c":"CA","d":"1999-10-15"},{"c":"IN","d":"1999-10-15"},{"c":"US","d":"1999-10-15"},{"c":"VN","d":"1999-10-15"},{"c":"BR","d":"1999-10-29"},{"c":"IT","d":"1999-10-29"},{"c":"AR","d":"1999-11-04"},{"c":"CH","d":"1999-11-04"},{"c":"NL","d":"1999-11-04"},{"c":"SG","d":"1999-11-04"},{"c":"DK","d":"1999-11-05"},{"c":"ES","d":"1999-11-05"},{"c":"IS","d":"1999-11-05"},{"c":"MX","d":"1999-11-05"},{"c":"BE","d":"1999-11-10"},{"c":"FR","d":"1999-11-10"},{"c":"AU","d":"1999-11-11"},{"c":"DE","d":"1999-11-11"},{"c":"HK","d":"1999-11-11"},{"c":"NZ","d":"1999-11-11"},{"c":"TW","d":"1999-11-11"},{"c":"FI","d":"1999-11-12"},{"c":"GB","d":"1999-11-12"},{"c":"IE","d":"1999-11-12"},{"c":"NO","d":"1999-11-12"},{"c":"PT","d":"1999-11-12"},{"c":"UY","d":"1999-11-12"},{"c":"KR","d":"1999-11-13"},{"c":"IL","d":"1999-11-16"