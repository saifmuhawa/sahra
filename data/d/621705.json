{"id":621705,"imdb":"tt7725384","en":"1982","orig":"1982","ar":null,"tag":null,"ov":"في صيف 1982، وبين أحضان مدرسة هادئة في جبال لبنان، يحاول طفل في الحادية عشرة من عمره الاعتراف بمشاعره لزميلته في الصف. بينما تلوح نذر الحرب في الأفق، تنقلب مجريات اليوم، كاشفة التوتر بين براءة الطفولة وقسوة الواقع. من خلال عيني طفل، يرسم الفيلم صورة مؤثرة عن الحب، والخوف، وقوة الروح البشرية في وجه الاضطراب.","rd":"2020-10-01","rt":100,"g":[18,36,10752],"lang":"ar","budget":0,"revenue":0,"companies":[{"n":"Tricycle Logic","logo":null,"c":""},{"n":"Abbout Productions","logo":"/wia94WcCrJC8SXxTcEqeqQS66Hk.png","c":"LB"},{"n":"Mad Dog Films","logo":null,"c":"US"},{"n":"Barentsfilm","logo":null,"c":"NO"}],"countries":["FR","LB","NO","QA"],"langs":["English","Arabic"],"col":null,"rel":[{"c":"QA","d":"2019-11-19"},{"c":"KR","d":"2020-06-20"},{"c":"AE","d":"2020-10-01"},{"c":"LB","d":"2020-10-01"},{"c":"SA","d":"2020-10-01"},{"c":"FR","d":"2021-11-24"},{"c":"SE","d":"2021-11-26"},{"c":"CA","d":"2022-04-01"},{"c":"MX","d":"2022-05-26"},{"c":"BR","d":"2022-06-02"},{"c":"TW","d":"2022-06-10"},{"c":"US","d":"2022-06-10"}],"dir":["Oualid Mouaness"],"prod":["Georges Schoucair","Alix Madigan-Yorkin","Oualid Mouaness","Myriam Sassine","Christopher Tricarico"],"wri":["Oualid Mouaness"],"mus":["Nadim Mishlawi"],"dop":["Brian Rigney Hubbard"],"cast":[{"n":"Nadine Labaki","ch":"Yasmine","p":"/mV1JAlM4CAdzosSqZs2ch2TPKLS.jpg"},{"n":"Mohammad Dali","ch":"Wissam","p":null},{"n":"Ghassan Maalouf","ch":"Majid","p":null},{"n":"Aliya Khalidi","ch":"Ms. Leila","p":null},{"n":"Rodrigue Sleiman","ch":"Joseph","p":null},{"n":"Gia Madi","ch":"Joana","p":null},{"n":"Lelya Harkous","ch":"Abir","p":null},{"n":"Said Serhan","ch":"Georges","p":"/tw5kq4tYDyOMs2iWjMSCBbRgEt3.jpg"},{"n":"Zeina Demelero","ch":"Carol (Majid's Mother)","p":null},{"n":"Joseph Azoury","ch":"Moses (Bus Driver)","p":null}]}