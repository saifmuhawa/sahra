{"id":144,"imdb":"tt0093191","en":"Wings of Desire","orig":"Der Himmel über Berlin","ar":null,"tag":"There are angels on the streets of Berlin.","ov":"Two angels, Damiel and Cassiel, glide through the streets of Berlin, observing the bustling population, providing invisible rays of hope to the distressed but never interacting with them. When Damiel falls in love with lonely trapeze artist Marion, the angel longs to experience life in the physical world, and finds — with some words of wisdom from actor Peter Falk — that it might be possible for him to take human form.","rd":"1987-09-23","rt":128,"g":[18,14,10749],"lang":"de","budget":2500000,"revenue":3548590,"companies":[{"n":"Road Movies","logo":"/tUkNOAjyTt9D56DUeQfmmAFvwYQ.png","c":"DE"},{"n":"Argos films","logo":"/yCu2D15iD7lcYsBWqXjU65U9nkH.png","c":"FR"},{"n":"WDR","logo":"/3xFdKHLXPGHEbrAkmsepGE8974Y.png","c":"DE"},{"n":"Wim Wenders Stiftung","logo":null,"c":"DE"}],"countries":["DE","FR"],"langs":["English","French","Hebrew","Japanese","Spanish","Turkish","German"],"col":"Damiel and Cassiel Collection","rel":[{"c":"CH","d":"1987-08-01"},{"c":"DK","d":"1987-09-23"},{"c":"FI","d":"1987-09-23"},{"c":"FR","d":"1987-09-23"},{"c":"SE","d":"1987-09-23"},{"c":"AT","d":"1987-10-01"},{"c":"DE","d":"1987-10-29"},{"c":"IT","d":"1987-12-11"},{"c":"PT","d":"1988-01-01"},{"c":"NL","d":"1988-03-03"},{"c":"AU","d":"1988-03-31"},{"c":"JP","d":"1988-04-23"},{"c":"US","d":"1988-04-29"},{"c":"BR","d":"1988-05-20"},{"c":"XC","d":"1991-05-01"},{"c":"KR","d":"1993-05-15"},{"c":"CZ","d":"2002-01-16"},{"c":"GR","d":"2006-11-17"},{"c":"GB","d":"2022-06-24"},{"c":"IN","d":"2025-02-05"},{"c":"TH","d":"2025-10-09"}],"dir":["Wim Wenders"],"prod":["Wim Wenders","Anatole Dauman"],"wri":["Peter Handke","Richard Reitinger","Wim Wenders","Bernard Eisenschitz"],"mus":["Jürgen Knieper"],"dop":["Henri Alekan"],"cast":[{"n":"Bruno Ganz","ch":"Damiel","p":"/8bhS1PObqe8OOVcyIRxV5Rcdufd.jpg"},{"n":"Solveig Dommartin","ch":"Marion","p":"/tUMenHJ42z0HNe