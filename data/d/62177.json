{"id":62177,"imdb":"tt1217209","en":"Brave","orig":"Brave","ar":"أسطورة مريدا","tag":"غير مصيرك","ov":"غير مصيرك.\r تدور أحداث شجاع في المرتفعات الاسكتلندية الغامضة ، حيث ميريدا هي أميرة مملكة يحكمها الملك فيرغوس والملكة إلينور. ابنة جامحة ورامية بارعة ، تتحدى ميريدا ذات يوم عادة مقدسة للأرض وتجلب الاضطرابات عن غير قصد إلى المملكة. في محاولة لوضع الأمور في نصابها الصحيح ، تبحث ميريدا عن امرأة حكيمة عجوز غريبة الأطوار وتمنح أمنية مشؤومة. كما أن البحث عن مسعى ميريدا - والعمل كإغاثة كوميدية - هو أمراء المملكة الثلاثة: اللورد ماكجوفين الهائل ، واللورد ماكنتوش العابس ، واللورد دينجوال البغيض.","rd":"2012-06-21","rt":93,"g":[12,16,10751,14],"lang":"en","budget":185000000,"revenue":538983207,"companies":[{"n":"Pixar","logo":"/1TjvGVDMYsj6JBxOAkUHpPEwLf7.png","c":"US"}],"countries":["US"],"langs":["English"],"col":null,"rel":[{"c":"AU","d":"2012-06-21"},{"c":"KZ","d":"2012-06-21"},{"c":"NZ","d":"2012-06-21"},{"c":"RU","d":"2012-06-21"},{"c":"UA","d":"2012-06-21"},{"c":"CA","d":"2012-06-22"},{"c":"ID","d":"2012-06-22"},{"c":"IN","d":"2012-06-22"},{"c":"TW","d":"2012-06-22"},{"c":"US","d":"2012-06-22"},{"c":"VN","d":"2012-07-06"},{"c":"AR","d":"2012-07-12"},{"c":"CL","d":"2012-07-12"},{"c":"IL","d":"2012-07-12"},{"c":"PY","d":"2012-07-13"},{"c":"BE","d":"2012-07-18"},{"c":"NL","d":"2012-07-18"},{"c":"BR","d":"2012-07-20"},{"c":"CO","d":"2012-07-20"},{"c":"MX","d":"2012-07-20"},{"c":"JP","d":"2012-07-21"},{"c":"DE","d":"2012-08-01"},{"c":"FR","d":"2012-08-01"},{"c":"PH","d":"2012-08-01"},{"c":"AT","d":"2012-08-02"},{"c":"HU","d":"2012-08-02"},{"c":"KH","d":"2012-08-02"},{"c":"BG","d":"2012-08-03"},{"c":"EE","d":"2012-08-03"},{"c":"IS","d":"2012-08-03"},{"c":"SG","d":"2012-08-08"},{"c":"HK","d":"2012-08-09"},{"c":"HR","d":"2012-08-09"},{"c":"ES","d":"2012-08-10"},{"c":"LT","d":"2012-08-10"},{"c":"GB","d":"2012-08-13"},{"c":"PT","d":"2012-08-15"},{"c":"CZ","d":"2012-08-16"},{"c":"IE","d":"2012-08-17"},{"c":"PL","d":"2012-08-17"}],"dir":["Mark Andrews","Brenda Chapman"],"prod":["