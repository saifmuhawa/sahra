{"id":111,"imdb":"tt0086250","en":"Scarface","orig":"Scarface","ar":"الوجه ذو الندبة","tag":"العالم لك ...","ov":"بعد حصوله على البطاقة الخضراء مقابل اغتيال مسؤول حكومي كوبي ، يطالب توني مونتانا بتجارة المخدرات في ميامي. يقتل توني بوحشية أي شخص يقف في طريقه ، ويصبح في النهاية أكبر أباطرة مخدرات في الولاية ، حيث يتحكم تقريبًا في كل الكوكايين الذي يأتي عبر ميامي. لكن الضغط المتزايد من الشرطة والحروب مع عصابات المخدرات الكولومبية والبارانويا التي تغذيها المخدرات تعمل على تأجيج نيران سقوطه في نهاية المطاف.","rd":"1983-12-09","rt":170,"g":[28,80,18],"lang":"en","budget":25000000,"revenue":66023329,"companies":[{"n":"Universal Pictures","logo":"/8lvHyhjr8oUKOOy2dKXoALWKdp0.png","c":"US"},{"n":"Martin Bregman Productions","logo":null,"c":"US"}],"countries":["US"],"langs":["English","Spanish"],"col":null,"rel":[{"c":"CA","d":"1983-12-09"},{"c":"NO","d":"1983-12-09"},{"c":"US","d":"1983-12-09"},{"c":"BR","d":"1984-01-13"},{"c":"AU","d":"1984-02-01"},{"c":"GB","d":"1984-02-03"},{"c":"AR","d":"1984-02-09"},{"c":"IE","d":"1984-02-17"},{"c":"FR","d":"1984-03-07"},{"c":"DE","d":"1984-03-08"},{"c":"FI","d":"1984-03-08"},{"c":"ES","d":"1984-03-12"},{"c":"GR","d":"1984-03-23"},{"c":"SE","d":"1984-03-23"},{"c":"NL","d":"1984-04-05"},{"c":"PT","d":"1984-04-12"},{"c":"IT","d":"1984-04-20"},{"c":"JP","d":"1984-04-28"},{"c":"MX","d":"1984-09-20"},{"c":"KR","d":"1984-12-08"},{"c":"HU","d":"1985-07-06"},{"c":"RU","d":"1987-11-13"},{"c":"PL","d":"1990-02-01"},{"c":"CZ","d":"2001-01-01"}],"dir":["Brian De Palma"],"prod":["Martin Bregman"],"wri":["Oliver Stone"],"mus":["Giorgio Moroder"],"dop":["John A. Alonzo"],"cast":[{"n":"Al Pacino","ch":"Tony Montana","p":"/m8HAAjq1T75JypKk0v1FFQn4ysZ.jpg"},{"n":"Steven Bauer","ch":"Manny Ray","p":"/eMSeKPgfilE2v5VcmwSt5pxbp0x.jpg"},{"n":"Michelle Pfeiffer","ch":"Elvira","p":"/8qwNMFzmM3BxGKIj1iIqiHHBpx3.jpg"},{"n":"Mary Elizabeth Mastrantonio","ch":"Gina","p":"/vbZ1E557K5oj34xLHR5ErO8wPCi.jpg"},{"n":"Robert Loggia","ch":"Frank Lopez","p":"/mRSUgJnfprCNw