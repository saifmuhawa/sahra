{"id":605,"imdb":"tt0242653","en":"The Matrix Revolutions","orig":"The Matrix Revolutions","ar":"الماتريكس الثورة","tag":"كل ما له بداية له نهاية.","ov":"يكتشف نيو (كيانو ريفز) أنه بطريقة ما قادر على استخدام قوته في العالم الحقيقي، وأن عقله باستطاعته التحرر من جسده؛ ولذلك يجد نفسه إذ فجاة محاصرًا في محطة قطار ما بين العالم الحقيقي والماتركس. في أثناء كل هذا تستعد زيون (ريني ناوفاهو) لحرب شعواء ضد الماكينات رغم صعوبة فوز زيون بتلك الحرب. وبين هذا وذاك لا يعلم كلا الطرفين أن هناك طرفًا ثالثًا يسعى للقضاء على العالم كله.","rd":"2003-11-05","rt":129,"g":[28,53,878],"lang":"en","budget":150000000,"revenue":424988211,"companies":[{"n":"Village Roadshow Pictures","logo":"/at4uYdwAAgNRKhZuuFX8ShKSybw.png","c":"US"},{"n":"NPV Entertainment","logo":null,"c":"US"},{"n":"Silver Pictures","logo":"/xlvoOZr4s1PygosrwZyolIFe5xs.png","c":"US"}],"countries":["US"],"langs":["English","French"],"col":"The Matrix Collection","rel":[{"c":"AU","d":"2003-11-05"},{"c":"BG","d":"2003-11-05"},{"c":"BR","d":"2003-11-05"},{"c":"CA","d":"2003-11-05"},{"c":"CH","d":"2003-11-05"},{"c":"CZ","d":"2003-11-05"},{"c":"DE","d":"2003-11-05"},{"c":"DK","d":"2003-11-05"},{"c":"EE","d":"2003-11-05"},{"c":"ES","d":"2003-11-05"},{"c":"FI","d":"2003-11-05"},{"c":"FR","d":"2003-11-05"},{"c":"GB","d":"2003-11-05"},{"c":"GR","d":"2003-11-05"},{"c":"HK","d":"2003-11-05"},{"c":"HU","d":"2003-11-05"},{"c":"IE","d":"2003-11-05"},{"c":"IT","d":"2003-11-05"},{"c":"JP","d":"2003-11-05"},{"c":"KR","d":"2003-11-05"},{"c":"MX","d":"2003-11-05"},{"c":"NL","d":"2003-11-05"},{"c":"NZ","d":"2003-11-05"},{"c":"PL","d":"2003-11-05"},{"c":"PT","d":"2003-11-05"},{"c":"RU","d":"2003-11-05"},{"c":"SE","d":"2003-11-05"},{"c":"SK","d":"2003-11-05"},{"c":"TW","d":"2003-11-05"},{"c":"US","d":"2003-11-05"},{"c":"SI","d":"2003-11-06"},{"c":"KZ","d":"2003-11-08"},{"c":"CN","d":"2026-10-17"}],"dir":["Lilly Wachowski","Lana Wachowski"],"prod":["Joel Silver"],"wri":["Lilly Wachowski","Lana Wachowski"],"mus":["Don Davis"],"dop":["Bill Pope"],"