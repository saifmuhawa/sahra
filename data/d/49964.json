{"id":49964,"imdb":"tt0093342","en":"Where Is The Friend's House?","orig":"خانه‌ی دوست کجاست؟","ar":"أين يقع منزل صديقي؟","tag":null,"ov":"بينما يستعد أحمد لأداء واجبه مساءً، يدرك أنه أخذ عن طريق الخطأ دفتر ملاحظات يخص أحد أصدقاءه. مع العلم أن صديقه قد تعرض للتوبيخ صباحًا وسيطرد إذا لم يكن لديه دفتر الملاحظات لإكمال واجبه المنزلي في اليوم التالي، يذهب أحمد للبحث عن زميله طيلة النهار، حتى يحل المساء ويشعر بخيبة أمل بعد عدم عثوره على منزل صديقه، فيقرر أن يقوم بكتابة واجبه عنه، يثني المعلم صباحًا على صحة حل الواجب ويشعر كلاهما بالرضا.","rd":"1987-07-01","rt":83,"g":[18,12],"lang":"fa","budget":0,"revenue":0,"companies":[{"n":"Kanoon","logo":"/q05YOjsHS2MBfteVQod3MRGkjCD.png","c":"IR"},{"n":"Farabi Cinema","logo":"/4JYTCYLW0ANUddBtjUvwa0MwRvL.png","c":"IR"}],"countries":["IR"],"langs":["Persian"],"col":"Koker Trilogy","rel":[{"c":"IR","d":"1987-07-01"},{"c":"FR","d":"1990-03-21"},{"c":"NL","d":"1992-11-05"},{"c":"KR","d":"1996-08-17"},{"c":"US","d":"2019-07-26"},{"c":"PT","d":"2020-11-07"},{"c":"GR","d":"2026-08-27"},{"c":"BR","d":"2026-09-02"}],"dir":["Abbas Kiarostami"],"prod":["Ali Reza Zarrin"],"wri":["Abbas Kiarostami"],"mus":["Amine Allah Hessine"],"dop":["Farhad Saba"],"cast":[{"n":"Babek Ahmadpour","ch":"Ahmad Ahmadpour","p":"/jfOIUu4Q8HyB9qtbCbeGpKDZWK6.jpg"},{"n":"Ahmed Ahmadpour","ch":"Mohamed Reza Nematzadeh","p":"/uxQwlReRXb6FoPpp6ZKT52bQ13E.jpg"},{"n":"Khodabakhsh Defai","ch":"Teacher","p":"/1aXIPt4h437zCfqjNHeKhDTuF8h.jpg"},{"n":"Iran Outari","ch":"Mother","p":null},{"n":"Ait Ansari","ch":"Father","p":null},{"n":"Sadika Taohidi","ch":"Persian Neighbour","p":null},{"n":"Biman Mouafi","ch":"Ali, a Neighbour","p":null},{"n":"Ali Djamali","ch":"Grandfather's Friend","p":null},{"n":"Aziz Babai","ch":"Waiter","p":null},{"n":"Nader Ghoulami","ch":"Property Owner","p":null},{"n":"Akbar Mouradi","ch":"Old Man from Azerbaidjan","p":null},{"n":"Teba Slimani","ch":"Husband","p":null},{"n":"Mohammad Reza Parvaneh","ch":"Morteza","p":"/uijY7Lh30fKYut1JvAcF8Ym8wqV.jpg"}