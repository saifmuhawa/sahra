{"id":198375,"imdb":"tt2591814","en":"The Garden of Words","orig":"言の葉の庭","ar":"حديقة الكلمات","tag":null,"ov":"يروي الفلم قصة الفتى تاكو صاحب طموحٍ ليكون صانع أحذية، يلتقي بامرأة غريبة تجلس في الحديقة عند هطول المطر، يتبادل الاثنان بضع كلمات مع بعضهما وفي نهاية اللقاء البكر والأول تلقي السيدة الشابة بيتاً شعرياً من نمط التانكا –شعر ياباني- في أسلوب توديع ثم يغادران. تتكرر اللقاءات في الأيام المطيرة بدون أية ترتيبات مسبقة، وتتواصل الأرواح أكثر، والشابة الجميلة المتأنقة يوكاري يوكينو تخرج القليل مما تكتمه في صدرها، غموضها الساحر وغياب التفاصيل يسحر تاكاو، ليس حباً لكنه ارتباط من نوع ما.","rd":"2013-05-31","rt":46,"g":[16,18,10749],"lang":"ja","budget":0,"revenue":820165,"companies":[{"n":"CoMix Wave Films","logo":"/t38uPdbKmyBB8brKKeTFWIwojRz.png","c":"JP"}],"countries":["JP"],"langs":["Japanese"],"col":null,"rel":[{"c":"AU","d":"2013-04-28"},{"c":"ES","d":"2013-05-31"},{"c":"GB","d":"2013-05-31"},{"c":"JP","d":"2013-05-31"},{"c":"TW","d":"2013-05-31"},{"c":"US","d":"2013-08-06"},{"c":"KR","d":"2013-08-14"},{"c":"RU","d":"2013-09-27"},{"c":"FR","d":"2014-01-08"},{"c":"DE","d":"2014-03-28"},{"c":"IT","d":"2014-05-21"}],"dir":["Makoto Shinkai"],"prod":["Noritaka Kawaguchi"],"wri":["Makoto Shinkai"],"mus":["Daisuke Kashiwa"],"dop":["Makoto Shinkai"],"cast":[{"n":"Miyu Irino","ch":"Takao Akizuki (voice)","p":"/8qEEhHUObNvGQr4e6eqLu5z4qTz.jpg"},{"n":"Kana Hanazawa","ch":"Yukari Yukino (voice)","p":"/9UTBlNRopSOKyoWnCm74tyHOfR1.jpg"},{"n":"Fumi Hirano","ch":"Takao's Mother (voice)","p":"/nP3c7cxj4iCHKCrlJtxtnsF3prS.jpg"},{"n":"Takeshi Maeda","ch":"Takao's Brother (voice)","p":"/k6tJ7W8jGCTNuD2NACzDO1VEZ44.jpg"},{"n":"Yuka Terasaki","ch":"Takao's Brother's Girlfriend (voice)","p":"/hMorHtbCmbDkznBr6P71qHk2rSL.jpg"},{"n":"Takanori Hoshino","ch":"Teacher Itou (voice)","p":"/ypoZIKRueZs3Fo8zxxe65O7Qwt.jpg"},{"n":"Suguru Inoue","ch":"Matsumoto (voice)","p":"/6u9GYi4Sje17oRKRCqMh9UcbAtq.jpg"},{"n":"Megumi Han","ch":"Satou (voice)","p":"/cwnwrPg1YvB19TbfouC4ShGPmbQ.jpg"},{"n":"Mi