{"id":1326106,"imdb":"tt35636950","en":"Kaiju No. 8: Mission Recon","orig":"怪獣８号 第1期総集編／同時上映「保科の休日」","ar":"Kaiju No.8","tag":null,"ov":"تدور أحداث القصة حول هيبينو كافكا، يبلغ من العمر 32 عامًا، والذي ينضم إلى جيش الدفاع والوفاء بوعده لصديقة طفولته، أشيرو مينا. يُكافأ صادقكا جماعيه الجديد في العمل، إيتشيكاوا رينو، أثناء تنظيفهما لبقايا الكايجو، ويلهمه رينو، بعزيمته على الانضمام إلى جيش الدفاع، وعد طفولته باجتياز اختبار القبول والانضمام إلى مينا لحماية البشر. عندما دخل كايجو الصغير داخل جسد كافكا، اكتسب القوة الخارقة الهائلة والكثافة الكايجو. يعمل كافكا على اكتساب الثقة في أن يكون من البشر، وهزيمة الكايجو الأقوياء بشكل متزايد، وذلك لسلامة العالم.","rd":"2025-03-28","rt":110,"g":[16,28,878],"lang":"ja","budget":0,"revenue":0,"companies":[{"n":"Production I.G","logo":"/rwB6w2aPENQbx756pBWSw44Ouk.png","c":"JP"},{"n":"Shueisha","logo":"/gyEWUBWwqrm3H5T2hkERD9LxpOq.png","c":"JP"},{"n":"TOHO","logo":"/fRSWWjquvzcHjACbtF53utZFIll.png","c":"JP"}],"countries":["JP"],"langs":["Japanese"],"col":null,"rel":[{"c":"JP","d":"2025-03-28"},{"c":"AU","d":"2025-04-10"},{"c":"BR","d":"2025-04-10"},{"c":"DO","d":"2025-04-10"},{"c":"NL","d":"2025-04-10"},{"c":"NZ","d":"2025-04-10"},{"c":"PA","d":"2025-04-10"},{"c":"PT","d":"2025-04-10"},{"c":"PL","d":"2025-04-11"},{"c":"US","d":"2025-04-13"},{"c":"IT","d":"2025-04-14"},{"c":"GB","d":"2025-04-16"},{"c":"FR","d":"2025-04-17"},{"c":"DE","d":"2025-04-29"},{"c":"TW","d":"2025-05-01"},{"c":"KR","d":"2025-05-07"},{"c":"ES","d":"2025-05-09"},{"c":"HK","d":"2025-05-15"},{"c":"PH","d":"2025-06-11"},{"c":"CN","d":"2025-06-14"},{"c":"SG","d":"2025-06-19"},{"c":"ID","d":"2025-06-20"},{"c":"PR","d":"2025-07-13"},{"c":"VI","d":"2025-07-13"}],"dir":["Shigeyuki Miya","Tomomi Kamiya"],"prod":[],"wri":["Ichiro Okouchi"],"mus":["Yuta Bandoh"],"dop":[],"cast":[{"n":"Masaya Fukunishi","ch":"Kafka Hibino / Kaiju No. 8 (voice)","p":"/8paIbTobS6266x57pIhJCq3mBJh.jpg"},{"n":"Wataru Katoh","ch":"Reno Ichikawa (voice)","p":"/7PUe94Ju0klZfEutSSbdOJyaV0y.jpg"},{"n":"F