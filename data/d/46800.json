{"id":46800,"imdb":"tt0057357","en":"Saladin","orig":"الناصر صلاح الدين","ar":"الناصر صلاح الدين","tag":null,"ov":"بعد انتصار صلاح الدين على ملك القدس، يتم توقيع معاهدة سلام بينهما إلا أن قائد الجيش الصليبي رينو دي شاتيون يقوم بذبح جماعة من الحجاج الذاهبين إلى مكة، يقرر صلاح الدين الانتقام، وبعد هزيمة الصليبيين، تبدأ فيرجينيا بتجميع الجيش للحرب، فتستنجد بالأمير كونراد لمساعدتها، ثم ملك إنجلترا (ريتشارد قلب الأسد) ويوافق ريتشارد بشرط أن يكون على رأس الصليبيين. ومن هنا تبدأ حملة صليبية جديدة ضد الشرق.","rd":"1963-02-25","rt":180,"g":[18,10752,36],"lang":"ar","budget":360000,"revenue":0,"companies":[{"n":"Egyptian General Corporation for Cinema","logo":null,"c":""},{"n":"لوتس فيلم (آسيا وشركاها)","logo":"/9Keu9ebYBHDJmX96Gq3H9djnwWc.png","c":"EG"}],"countries":["EG"],"langs":["Arabic"],"col":null,"rel":[{"c":"EG","d":"1963-02-25"},{"c":"DE","d":"2020-12-04"},{"c":"TW","d":"2026-06-27"}],"dir":["Youssef Chahine"],"prod":["Assia Dagher"],"wri":["Youssef Chahine","Naguib Mahfouz","Youssef El Sebai"],"mus":["Angelo Francesco Lavagnino"],"dop":["Wadid Sirry"],"cast":[{"n":"Ahmad Mazhar","ch":"Saladin","p":"/7B1ShnTfRABhkzG6Wm3FO3P3Hof.jpg"},{"n":"Nadia Lotfi","ch":"Louisa de Lusignan","p":"/6qJAcrxlLPC6b7YfM8LXn2Xdej6.jpg"},{"n":"Salah Zulfikar","ch":"Issa El Awwam","p":"/kn8pSGnHMfDGgNgYAuF7IV9K9cd.jpg"},{"n":"Laila Fawzy","ch":"Virginia, Princess of Kerak","p":"/9IzIgBzjYUWkBMXy7ZcJL2zM02.jpg"},{"n":"Hamdy Ghaith","ch":"Richard the Lionheart","p":"/2ncZ7niUc54L0DWKqdb0EZkLpGh.jpg"},{"n":"Laila Taher","ch":"Queen Berengaria","p":"/5fod7Cs6hlquA0LwJwf3se8qtJk.jpg"},{"n":"Omar Al-Hariri","ch":"King Philip of France","p":"/2UjTbJxOgc96wpO8zTzCgSu1Puf.jpg"},{"n":"Hussein Reyaad","ch":"Issa Hikari","p":"/4kRlJNHVFS2Aolyt6Kl7FgxR8k7.jpg"},{"n":"Mahmood Al-Meleji","ch":"Conrad, Marquis of Montferrat","p":"/3WWkVGMG4KfWhn2XwPJYdUOasX7.jpg"},{"n":"Zaki Toleimat","ch":"Duke Arthur","p":"/116HvMhMRGnAVXR9YW2fJ4Zy5wh.jpg"},{"n":"Tawfiq Al-Deqen","ch":"Prince of Akka","p":"/wSEkxb6F73s