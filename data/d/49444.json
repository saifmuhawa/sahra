{"id":49444,"imdb":"tt1302011","en":"Kung Fu Panda 2","orig":"Kung Fu Panda 2","ar":"كونغ فو باندا 2","tag":"روعة مضاعفة.","ov":"يعيش بو الآن حلمه كمحارب التنين ، ويحمي وادي السلام جنبا إلى جنب مع أصدقائه وزملائه أساتذة الكونغ فو ، الخمسة الغاضبون - النمره و كركي و السرعوف و الافعي و القرد . لكن حياة بو الجديدة من الذهول مهددة بظهور شرير هائل ، يخطط لاستخدام سلاح سري لا يمكن إيقافه لغزو الصين وتدمير الكونغ فو. الأمر متروك لبو والخمسة الغاضبون  للسفر عبر الصين لمواجهة هذا التهديد وقهره. ولكن كيف يمكن لبو أن يوقف سلاحا يمكنه إيقاف الكونغ فو؟ يجب أن ينظر إلى ماضيه ويكشف أسرار أصوله الغامضة. عندها فقط سيكون قادرا على إطلاق العنان للقوة التي يحتاجها للنجاح.","rd":"2011-05-25","rt":91,"g":[16,10751,35,28],"lang":"en","budget":150000000,"revenue":665692281,"companies":[{"n":"DreamWorks Animation","logo":"/3BPX5VGBov8SDqTV7wC1L1xShAS.png","c":"US"}],"countries":["US"],"langs":["English"],"col":"Kung Fu Panda Collection","rel":[{"c":"BR","d":"2011-05-25"},{"c":"CA","d":"2011-05-25"},{"c":"KZ","d":"2011-05-25"},{"c":"KR","d":"2011-05-26"},{"c":"US","d":"2011-05-26"},{"c":"PL","d":"2011-05-27"},{"c":"VN","d":"2011-06-01"},{"c":"CZ","d":"2011-06-02"},{"c":"GR","d":"2011-06-02"},{"c":"HU","d":"2011-06-02"},{"c":"EE","d":"2011-06-03"},{"c":"LT","d":"2011-06-03"},{"c":"SE","d":"2011-06-08"},{"c":"MX","d":"2011-06-10"},{"c":"RO","d":"2011-06-10"},{"c":"TR","d":"2011-06-10"},{"c":"FI","d":"2011-06-11"},{"c":"CH","d":"2011-06-15"},{"c":"DE","d":"2011-06-15"},{"c":"FR","d":"2011-06-15"},{"c":"NL","d":"2011-06-15"},{"c":"DK","d":"2011-06-16"},{"c":"ES","d":"2011-06-17"},{"c":"NO","d":"2011-06-17"},{"c":"AU","d":"2011-06-23"},{"c":"NZ","d":"2011-07-07"},{"c":"HK","d":"2011-07-21"},{"c":"GB","d":"2011-07-29"},{"c":"IE","d":"2011-07-29"},{"c":"ID","d":"2011-08-16"},{"c":"JP","d":"2011-08-19"},{"c":"IT","d":"2011-08-24"}],"dir":["Jennifer Yuh Nelson"],"prod":["Melissa Cobb"],"wri":["Jonathan Aibel","Glenn Berger","Li Hong","Ryan Crego","Radford Sechrist","Derek Drymon"],"mus":["John Powell