{"id":1400940,"imdb":"tt34890576","en":"Clayface","orig":"Clayface","ar":"كلايفيس","tag":"انظر إلى الخوف في وجهه.","ov":"يصعد \"مات هايغن\" بسرعة مذهلة من طفل شوارع في مدينة غوثام إلى نجم سينمائي لامع في هوليوود، لكن مسيرته تنتهي بشكل مأساوي عندما تتسبب أفعال أحد زعماء الجريمة المحليين في تشويه وجهه بشكل مروّع. وبعد أن يتخلى عنه فريقه ويجد نفسه بلا أي شيء، يلجأ مات إلى علاج متطور بتقنيات حديثة يعيده بأعجوبة إلى هيئته السابقة... لكنه يُحدث أيضًا تأثيرًا غير متوقع على قدرته على التمييز بين الواقع والخيال، ليدخل في دوامة مدمرة من الانتقام الأعمى الذي يلتهم كل شيء في طريقه.","rd":"2026-10-19","rt":109,"g":[27,53,878],"lang":"en","budget":44000000,"revenue":121334121,"companies":[{"n":"DC Studios","logo":"/uVpjHYq5AbiG2qj82ZRBM4VFL3o.png","c":"US"},{"n":"Domain Entertainment","logo":"/kKVYqekveOvLK1IgqdJojLjQvtu.png","c":"US"},{"n":"6th & Idaho Motion Picture Company","logo":"/iusVPF9AJD1DiHEWbZEXgn1hpOf.png","c":"US"},{"n":"Troll Court Entertainment","logo":"/kxuhS8wyKtVprOn5nckdHyNuSg1.png","c":"US"},{"n":"The Safran Company","logo":"/odU3l6csuBmXUrzFm6araUgEUHQ.png","c":"US"}],"countries":["US"],"langs":["English"],"col":null,"rel":[{"c":"GB","d":"2026-10-19"},{"c":"IE","d":"2026-10-19"},{"c":"BE","d":"2026-10-21"},{"c":"FR","d":"2026-10-21"},{"c":"GP","d":"2026-10-21"},{"c":"ID","d":"2026-10-21"},{"c":"KR","d":"2026-10-21"},{"c":"LU","d":"2026-10-21"},{"c":"MA","d":"2026-10-21"},{"c":"MQ","d":"2026-10-21"},{"c":"MX","d":"2026-10-21"},{"c":"PH","d":"2026-10-21"},{"c":"AE","d":"2026-10-22"},{"c":"AG","d":"2026-10-22"},{"c":"AL","d":"2026-10-22"},{"c":"AR","d":"2026-10-22"},{"c":"AT","d":"2026-10-22"},{"c":"AU","d":"2026-10-22"},{"c":"AW","d":"2026-10-22"},{"c":"AZ","d":"2026-10-22"},{"c":"BA","d":"2026-10-22"},{"c":"BB","d":"2026-10-22"},{"c":"BH","d":"2026-10-22"},{"c":"BN","d":"2026-10-22"},{"c":"BO","d":"2026-10-22"},{"c":"BR","d":"2026-10-22"},{"c":"BY","d":"2026-10-22"},{"c":"BZ","d":"2026-10-22"},{"c":"CH","d":"2026-10-22"},{"c":"CL","d":"2026-10-22"},{"c":"CO","