{"id":936075,"imdb":"tt11378946","en":"Michael","orig":"Michael","ar":"مايكل","tag":"اكتشف كيف يُصنع الملوك.","ov":"يروي الفيلم قصة حياة مايكل جاكسون بعيداً عن الموسيقى، متتبعاً رحلته منذ اكتشاف موهبته الاستثنائية كقائد لفرقة \"جاكسون فايف\"، وصولاً إلى الفنان الملهم الذي دفع طموحه الإبداعي سعياً حثيثاً ليصبح أعظم فنان استعراضي في العالم. ومن خلال تسليط الضوء على حياته خارج الأضواء وبعض أكثر عروضه شهرة في بدايات مسيرته المنفردة، يمنح الفيلم الجمهور فرصة لمشاهدة مايكل جاكسون كما لم يروه من قبل. من هنا تبدأ قصته.","rd":"2026-04-22","rt":128,"g":[10402,18],"lang":"en","budget":250000000,"revenue":1028703388,"companies":[{"n":"Lionsgate","logo":"/cisLn1YAUuptXVBa0xjq7ST9cH0.png","c":"US"},{"n":"GK Films","logo":"/8tMybAieh64uzvm8knSjXOFX8Qc.png","c":"US"},{"n":"Optimum Productions","logo":"/aQrYO4ziZbm24huYBahFKG4TfrJ.png","c":"US"}],"countries":["US"],"langs":["English"],"col":"Michael Collection","rel":[{"c":"AE","d":"2026-04-22"},{"c":"AR","d":"2026-04-22"},{"c":"AT","d":"2026-04-22"},{"c":"AU","d":"2026-04-22"},{"c":"AZ","d":"2026-04-22"},{"c":"BE","d":"2026-04-22"},{"c":"BH","d":"2026-04-22"},{"c":"CH","d":"2026-04-22"},{"c":"CL","d":"2026-04-22"},{"c":"CZ","d":"2026-04-22"},{"c":"DE","d":"2026-04-22"},{"c":"EE","d":"2026-04-22"},{"c":"ES","d":"2026-04-22"},{"c":"FR","d":"2026-04-22"},{"c":"GB","d":"2026-04-22"},{"c":"GR","d":"2026-04-22"},{"c":"HK","d":"2026-04-22"},{"c":"ID","d":"2026-04-22"},{"c":"IE","d":"2026-04-22"},{"c":"IS","d":"2026-04-22"},{"c":"KZ","d":"2026-04-22"},{"c":"LV","d":"2026-04-22"},{"c":"MX","d":"2026-04-22"},{"c":"NZ","d":"2026-04-22"},{"c":"PH","d":"2026-04-22"},{"c":"SE","d":"2026-04-22"},{"c":"TW","d":"2026-04-22"},{"c":"VN","d":"2026-04-22"},{"c":"BR","d":"2026-04-23"},{"c":"CA","d":"2026-04-23"},{"c":"CO","d":"2026-04-23"},{"c":"GT","d":"2026-04-23"},{"c":"HR","d":"2026-04-23"},{"c":"HU","d":"2026-04-23"},{"c":"IL","d":"2026-04-23"},{"c":"IN","d":"2026-04-23"},{"c":"IT","d":"2026-04-23"},{"c":"KH","d":"2026-04-23"},{"c":"NL","d":"2026-0