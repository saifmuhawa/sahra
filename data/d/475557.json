{"id":475557,"imdb":"tt7286456","en":"Joker","orig":"Joker","ar":"جوكر","tag":"وضع على وجه سعيد.","ov":"آرثر فليك رجل وحيد يعيش في مدينة غوثام ويعمل مهرجًا ويطمح إلى أن يصبح كوميديًا مشهورًا، لكنه يواجه الإهمال والسخرية والظروف القاسية التي تحيط به. تتوالى عليه الأزمات وتزداد معاناته مع المجتمع من حوله، بينما تنهار حياته تدريجيًا وتتعرض أحلامه للانكسار. ومع تراكم الإحباط والغضب، يبدأ آرثر في فقدان السيطرة على نفسه، ويتخلى شيئًا فشيئًا عن هويته القديمة ليظهر بشخصية الجوكر، فيتحول غضبه الشخصي إلى شرارة تشعل الفوضى والاحتجاجات في شوارع غوثام.","rd":"2019-10-01","rt":122,"g":[80,53,18],"lang":"en","budget":55000000,"revenue":1078958629,"companies":[{"n":"Warner Bros. Pictures","logo":"/zhD3hhtKB5qyv7ZeL4uLpNxgMVU.png","c":"US"},{"n":"Joint Effort","logo":null,"c":"US"},{"n":"Village Roadshow Pictures","logo":"/at4uYdwAAgNRKhZuuFX8ShKSybw.png","c":"US"},{"n":"Bron Studios","logo":"/aTc07YaNHo8WNgkQSnvLmG6w4nW.png","c":"CA"},{"n":"DC Films","logo":"/13F3Jf7EFAcREU0xzZqJnVnyGXu.png","c":"US"}],"countries":["CA","US"],"langs":["English"],"col":"Joker Collection","rel":[{"c":"LV","d":"2019-10-01"},{"c":"BE","d":"2019-10-02"},{"c":"ID","d":"2019-10-02"},{"c":"IN","d":"2019-10-02"},{"c":"KR","d":"2019-10-02"},{"c":"AE","d":"2019-10-03"},{"c":"AR","d":"2019-10-03"},{"c":"AU","d":"2019-10-03"},{"c":"BR","d":"2019-10-03"},{"c":"CH","d":"2019-10-03"},{"c":"CL","d":"2019-10-03"},{"c":"CO","d":"2019-10-03"},{"c":"CZ","d":"2019-10-03"},{"c":"DK","d":"2019-10-03"},{"c":"GE","d":"2019-10-03"},{"c":"GR","d":"2019-10-03"},{"c":"HK","d":"2019-10-03"},{"c":"HU","d":"2019-10-03"},{"c":"IT","d":"2019-10-03"},{"c":"JO","d":"2019-10-03"},{"c":"KW","d":"2019-10-03"},{"c":"KZ","d":"2019-10-03"},{"c":"MO","d":"2019-10-03"},{"c":"NL","d":"2019-10-03"},{"c":"NZ","d":"2019-10-03"},{"c":"PE","d":"2019-10-03"},{"c":"PH","d":"2019-10-03"},{"c":"PT","d":"2019-10-03"},{"c":"QA","d":"2019-10-03"},{"c":"RO","d":"2019-10-03"},{"c":"RU","d":"2019-10-03"},{"c":"SG","d":"2019-10-03"},{"c":"SK","d":"2019-10-03"