{"id":569094,"imdb":"tt9362722","en":"Spider-Man: Across the Spider-Verse","orig":"Spider-Man: Across the Spider-Verse","ar":"سبايدرمان: عبر عالم العنكبوت","tag":"المهم هو كيفية ارتداء القناع.","ov":"يواصل مايلز موراليس رحلته كبطل خارق بعد أن اعتاد على حياته الجديدة كسبايدرمان، لكنه يجد نفسه أمام مغامرة تتجاوز عالمه عندما تفتح أمامه بوابات تقوده إلى أكوان موازية. يلتقي مايلز بعدد كبير من نسخ سبايدرمان من عوالم مختلفة، من بينهم غوين ستايسي، وينضم إلى مجموعة من أبطال العنكبوت الذين يحمون توازن الأكوان. ومع اكتشافه أن هناك أحداثًا مأساوية تبدو مرتبطة بمصير كل سبايدرمان، يحاول مايلز تحدي القواعد وإنقاذ الأشخاص الذين يحبهم، ليجد نفسه في مواجهة صراع يهدد بتغيير مصير الأكوان المتعددة.","rd":"2023-05-31","rt":140,"g":[16,28,12,878],"lang":"en","budget":100000000,"revenue":690897910,"companies":[{"n":"Columbia Pictures","logo":"/71BqEFAF4V3qjjMPCpLuyJFB9A.png","c":"US"},{"n":"Sony Pictures Animation","logo":"/5ilV5mH3gxTEU7p5wjxptHvXkyr.png","c":"US"},{"n":"Lord Miller","logo":"/fAajboa3w8LNvweN0hNZ4K0z03L.png","c":"US"},{"n":"Pascal Pictures","logo":"/nw4kyc29QRpNtFbdsBHkRSFavvt.png","c":"US"},{"n":"Arad Productions","logo":null,"c":"US"},{"n":"Marvel Entertainment","logo":"/837VMM4wOkODc1idNxGT0KQJlej.png","c":"US"}],"countries":["US"],"langs":["English","Hindi","Italian","Spanish"],"col":"Spider-Man: Spider-Verse Collection","rel":[{"c":"BE","d":"2023-05-31"},{"c":"CH","d":"2023-05-31"},{"c":"FI","d":"2023-05-31"},{"c":"FR","d":"2023-05-31"},{"c":"ID","d":"2023-05-31"},{"c":"IL","d":"2023-05-31"},{"c":"IS","d":"2023-05-31"},{"c":"LA","d":"2023-05-31"},{"c":"LU","d":"2023-05-31"},{"c":"PH","d":"2023-05-31"},{"c":"TH","d":"2023-05-31"},{"c":"AL","d":"2023-06-01"},{"c":"AM","d":"2023-06-01"},{"c":"AO","d":"2023-06-01"},{"c":"AR","d":"2023-06-01"},{"c":"AT","d":"2023-06-01"},{"c":"AU","d":"2023-06-01"},{"c":"AZ","d":"2023-06-01"},{"c":"BA","d":"2023-06-01"},{"c":"BO","d":"2023-06-01"},{"c":"BR","d":"2023-06-01"},{"c":"BS","d":"2023-06-01"},{"c":"CL","d":"2023-06-01"},{"c":"CO