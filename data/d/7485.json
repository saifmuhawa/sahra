{"id":7485,"imdb":"tt0822854","en":"Shooter","orig":"Shooter","ar":"القناص","tag":"أمس كان عن الشرف. اليوم يتعلق بالعدالة.","ov":"بوب لي سواغر قناص محترف سابق في قوات مشاة البحرية الأمريكية يعيش منعزلًا بعد تعرضه للخيانة خلال إحدى مهماته، إلى أن يُطلب منه تنفيذ مهمة لحماية الرئيس الأمريكي من محاولة اغتيال محتملة. يوافق سواغر على المهمة، لكنه يكتشف سريعًا أنه تعرض لمؤامرة مدبرة، ويتم اتهامه بجريمة لم يرتكبها. بعد فراره، يبدأ رحلة لكشف الحقيقة والانتقام من المسؤولين عن خيانته، مستعينًا بمهاراته العسكرية وخبرته في تعقب أعدائه، بينما يحاول النجاة من مطاردة واسعة تقودها جهات نافذة.","rd":"2007-03-22","rt":124,"g":[18,28,53],"lang":"en","budget":61000000,"revenue":95700000,"companies":[{"n":"Paramount Pictures","logo":"/jay6WcMgagAklUt7i9Euwj1pzTF.png","c":"US"},{"n":"di Bonaventura Pictures","logo":"/AjzK0s2w1GtLfR4hqCjVSYi0Sr8.png","c":"US"},{"n":"Grosvenor Park Impact Productions","logo":null,"c":"CA"}],"countries":["US"],"langs":["English"],"col":null,"rel":[{"c":"US","d":"2007-03-22"},{"c":"KR","d":"2007-04-06"},{"c":"NL","d":"2007-04-12"},{"c":"PT","d":"2007-04-12"},{"c":"BG","d":"2007-04-13"},{"c":"GB","d":"2007-04-13"},{"c":"IE","d":"2007-04-13"},{"c":"RO","d":"2007-04-13"},{"c":"FR","d":"2007-04-18"},{"c":"AU","d":"2007-04-19"},{"c":"BR","d":"2007-04-19"},{"c":"DE","d":"2007-04-19"},{"c":"HU","d":"2007-04-19"},{"c":"NO","d":"2007-04-19"},{"c":"DK","d":"2007-04-20"},{"c":"IT","d":"2007-04-20"},{"c":"LT","d":"2007-04-20"},{"c":"SE","d":"2007-04-20"},{"c":"GR","d":"2007-04-24"},{"c":"CZ","d":"2007-04-26"},{"c":"PL","d":"2007-05-11"},{"c":"TR","d":"2007-05-11"},{"c":"JP","d":"2007-06-01"}],"dir":["Antoine Fuqua"],"prod":["Lorenzo di Bonaventura","Ric Kidney"],"wri":["Stephen Hunter","Jonathan Lemkin"],"mus":["Mark Mancina"],"dop":["Peter Menzies Jr."],"cast":[{"n":"Mark Wahlberg","ch":"Bob Lee Swagger","p":"/1Oc3XSLyb8hxmjmlgFENu582Kqw.jpg"},{"n":"Michael Peña","ch":"Nick Memphis","p":"/afs4PCiwn8LR93a10drULLVeVLo.jpg"},{"n":"Danny Glover","ch":"Colonel Isaac Johnson