{"id":103569,"q":"Q103569","imdb":"tt0078748","en":"Alien","orig":"Alien","ar":"فضائي","tag":null,"ov":"فضائي (الإنجليزية: Alien) هو فيلم رعب خيالي علمي أمريكي بريطاني أُصدر عام 1979 من إخراج ريدلي سكوت وبطولة توم سكيريت، سيغورني ويفر، فيرونيكا كارترايت، هاري دين ستانتون، جون هرت، إيان هولم و‌يافيت كوتو. يشير عنوان الفيلم إلى الكائن الشديد العدوانية الذي يتتبع ويقتل طاقم السفينة الفضائية. كتب دان أوبانون السيناريو من قصة كتبها مع رونالد سشيت، متأثرًا بأعمال سابقة في مجال الخيال العلمي والرعب. أنتَج الفيلم غوردون كارول وديفيد جيلر ووالتر هيل ووُزع من طرف تونتيث سينتشوري فوكس.","plotEn":"","rd":"1979-05-25","rt":117,"g":[14,28,27,12,878,9648,53],"lang":"en","budget":11000000,"revenue":106285522,"companies":[{"n":"20th Century Studios"},{"n":"Brandywine Productions"}],"countries":["US","GB"],"langs":[],"col":null,"rel":[],"dir":["Ridley Scott"],"prod":["Walter Hill","Gordon Carroll","David Giler"],"wri":["Dan O'Bannon","Ronald Shusett"],"mus":["Jerry Goldsmith"],"dop":["Derek Vanlint"],"cast":[{"n":"Ian Holm","ch":"Ash","p":null},{"n":"Ian Holm","ch":"Ash","p":null},{"n":"Harry Dean Stanton","ch":"Samuel Brett","p":null},{"n":"Harry Dean Stanton","ch":"Samuel Brett","p":null},{"n":"Sigourney Weaver","ch":"Ellen Ripley","p":null},{"n":"Sigourney Weaver","ch":"Ellen Ripley","p":null},{"n":"Yaphet Kotto","ch":"Dennis Monroe Parker","p":null},{"n":"Yaphet Kotto","ch":"Dennis Monroe Parker","p":null},{"n":"Bolaji Badejo","ch":"Big Chap","p":null},{"n":"Bolaji Badejo","ch":"Big Chap","p":null},{"n":"John Hurt","ch":"Gilbert Kane","p":null},{"n":"John Hurt","ch":"Gilbert Kane","p":null},{"n":"Eddie Powell","ch":"Big Chap","p":null},{"n":"Veronica Cartwright","ch":"Joan Lambert","p":null},{"n":"Veronica Cartwright","ch":"Joan Lambert","p":null},{"n":"Tom Skerritt","ch":"Arthur Dallas","p":null}],"wiki":{"en":"Alien (film)","ar":"فضائي (فلم)"}}