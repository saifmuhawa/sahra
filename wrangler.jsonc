{
  // إعدادات Cloudflare لموقع سهرة فيلم
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahra",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "POLLS", "class_name": "Poll" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Poll"] }
  ],
  // الحسابات والعملات (المرحلة ٢)
  "d1_databases": [
    { "binding": "DB", "database_name": "sahra-db", "database_id": "546341eb-2c5e-459b-af4d-1e004e40fb24", "migrations_dir": "migrations" }
  ],
  "vars": {
    // لما يصير عندنا دومين خاص، بنحطه هون وكل الروابط الثانية بتتحوّل عليه
    "CANONICAL_HOST": "sahrafilm.com",
    // "1" = الحكم لازم يكون مسجّل دخول عشان يعمل غرفة. مطفي لحد ما تشتغل الإيميلات
    "JUDGE_LOGIN": "0",
    // كم عملة بتكلّف الغرفة. 0 = ببلاش (لحد ما يشتغل الدفع)
    "ROOM_COINS": "0",
    // Turnstile (مربع "مش روبوت") على التسجيل والدخول: المفتاح العام. السري بـ TURNSTILE_SECRET
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGVlwVme1FwbdW7T",
    // رابط Google Apps Script لمشاركات المسابقة (كان بصفحة contest.html، صار هون عشان البوتات ما تشوفه)
    "CONTEST_URL": "https://script.google.com/macros/s/AKfycbwLTQzPc1B6H1t-KEAMAG_4LPW78QijvmZKOgaLFqWrBBfKMePWNMNvwGOGli8ZD_rwMA/exec"
  },
  // الدومين الخاص: Cloudflare بيربطه لحاله وقت النشر
  "routes": [
    { "pattern": "sahrafilm.com", "custom_domain": true },
    { "pattern": "www.sahrafilm.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
